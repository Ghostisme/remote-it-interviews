{
  "name": "odyssey-restaurant-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:dashboard": "pnpm --filter @odyssey/dashboard dev",
    "dev:backend": "pnpm --filter @odyssey/backend dev",
    "db:up": "node scripts/database.mjs up",
    "db:down": "node scripts/database.mjs down",
    "db:migrate": "pnpm --filter @odyssey/backend db:migrate",
    "db:seed": "pnpm --filter @odyssey/backend db:seed",
    "setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm gen:contract",
    "gen:contract": "pnpm --filter @odyssey/backend gen:openapi && pnpm --filter @odyssey/api-client generate",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
